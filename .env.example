# ---------------------------------------------------------------------------
# Vaganza — environment variables
# Copy this file to `.env.local` and fill in your Shopify credentials.
#
# Until these are set, the storefront runs on the built-in mock catalogue:
# the site fully builds, renders and demos — checkout falls back to WhatsApp.
# ---------------------------------------------------------------------------

# Your Shopify store domain (the *.myshopify.com domain, not the custom one)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token
# Shopify admin → Settings → Apps and sales channels → Develop apps
# → create an app → Storefront API → install → copy the Storefront API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-access-token

# Optional — Storefront API version (defaults to 2025-10)
# SHOPIFY_API_VERSION=2025-10
